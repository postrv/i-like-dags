{
  "$schema": "./worker/node_modules/wrangler/config-schema.json",
  // PUBLIC DEMO ONLY: keeps the workers.dev console attached to the R2 data
  // referenced by this Worker's existing Durable Object heads. It deliberately
  // never satisfies production readiness; use wrangler.r2.jsonc behind a
  // managed perimeter for production.
  "name": "dag-edge",
  "main": "worker/src/index.ts",
  "compatibility_date": "2026-08-23",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "DAG_EDGE_MODE": "demo-r2",
    "DAG_RETAINED_BYTES_LIMIT": "268435456",
    "DAG_RETAINED_OBJECTS_LIMIT": "10000"
  },
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 0.1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  },
  "assets": {
    "directory": "worker/public",
    "binding": "ASSETS",
    "run_worker_first": true,
    "html_handling": "none",
    "not_found_handling": "none"
  },
  "r2_buckets": [
    { "binding": "CHUNKS", "bucket_name": "dag-chunks" }
  ],
  "ratelimits": [
    {
      "name": "INGEST_RATE_LIMITER",
      "namespace_id": "42001",
      "simple": { "limit": 300, "period": 60 }
    },
    {
      "name": "PUBLIC_READ_RATE_LIMITER",
      "namespace_id": "42002",
      "simple": { "limit": 300, "period": 60 }
    }
  ],
  "durable_objects": {
    "bindings": [
      { "name": "POINTERS", "class_name": "PointerObject" },
      { "name": "PINS", "class_name": "PinObject" },
      { "name": "CATALOG", "class_name": "CatalogObject" }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["PointerObject", "PinObject", "CatalogObject"]
    }
  ]
}
